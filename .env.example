# Copy to .env.local for development. Set the same keys in Vercel for production.
# Never prefix secrets with NEXT_PUBLIC_ — those are bundled into client code.

NEXT_PUBLIC_SITE_URL=http://localhost:3000

# MariaDB on the Ubuntu server — use a dedicated least-privilege user
DATABASE_URL=

# Clerk (https://dashboard.clerk.com) — account manager - email+password, google + discord OAuth
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# Comma-separated Clerk user IDs with admin panel access
ADMIN_USER_IDS=

# Stripe (https://dashboard.stripe.com/apikeys)
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx

# Resend (https://resend.com/api-keys)
RESEND_API_KEY=re_xxx
EMAIL_FROM="Gaminfy <orders@gaminfy.rs>"
CONTACT_EMAIL_TO=support@gaminfy.com

# Cloudflare R2
R2_ACCOUNT_ID=...
R2_ACCESS_KEY_ID=...
R2_SECRET_ACCESS_KEY=...
R2_BUCKET=gaminfy-images
R2_PUBLIC_URL=https://cdn.gaminfy.rs